# Copy this file to server/.env and fill in real values.
# NEVER commit server/.env.

# Server
PORT=3001
NODE_ENV=development

# Security - generate strong random values, e.g. with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
REFRESH_SECRET=
ADMIN_PASSWORD=

# App
# Comma-separated allowlist of origins allowed to call the API (CORS).
# Leave empty in production to restrict to same-origin requests.
APP_URL=http://localhost:5173

# SMTP (email sending). Fill in real SMTP credentials to enable
# verification/reset emails. Leave empty for demo mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@tradehub.app
EMAIL_FROM_NAME=TradeHub

# Paystack (payments). Fill in real keys to enable card & bank-transfer payments.
# Get keys at https://dashboard.paystack.com -> Settings -> API Keys & Webhooks.
# PAYSTACK_WEBHOOK_SECRET is required for webhooks to be accepted.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CURRENCY=NGN
# Where Paystack redirects the buyer after a charge (your frontend URL).
# PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/status
# Country code used for the Paystack bank list (nigeria | ghana | kenya | south_africa)
PAYSTACK_BANK_COUNTRY=nigeria
# Set to false to hide the Paystack Bank Transfer (pay-bank) checkout option.
PAYSTACK_BANK_TRANSFER_ENABLED=true
# Platform fee charged to sellers. 0 disables it.
PAYMENT_FEE_PERCENT=0

# AI features (listing assistant, smart search, buyer Q&A, price guide).
# Set OPENAI_API_KEY to enable LLM-powered answers. Without it, every AI
# feature still works using smart local fallbacks (market data + templates).
# OPENAI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini

# Bank transfer details (shown to buyers when legacy bank transfer is enabled)
BANK_TRANSFER_ENABLED=false
BANK_ACCOUNT_NAME=TradeHub Marketplace Ltd
BANK_NAME=Example National Bank
BANK_ACCOUNT_NUMBER=000123456789
BANK_ROUTING=021000021
BANK_SWIFT=EXNBUS33

# Crypto payments (shown to buyers when crypto is enabled) - deprecated
CRYPTO_ENABLED=false
# Optional per-currency addresses, e.g. CRYPTO_ADDRESS_BTC=<btc address>

# Escrow (runs on an hourly cron)
AUTO_RELEASE_DAYS=7
ABANDON_PAYMENT_HOURS=24

# Serverless (Netlify) - set to true on Netlify
# NETLIFY=true
# DB_BLOB=true

# Firebase (optional - for Auth, Push Notifications, Storage)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
# FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# FIREBASE_STORAGE=false
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
