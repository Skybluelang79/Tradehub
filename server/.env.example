# Copy this file to server/.env and fill in real values.
# NEVER commit server/.env.

# Server
PORT=3001
NODE_ENV=development

# Security - generate strong random values, e.g. with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
REFRESH_SECRET=
ADMIN_PASSWORD=

# App
# Comma-separated allowlist of origins allowed to call the API (CORS).
# Leave empty in production to restrict to same-origin requests.
APP_URL=http://localhost:5173

# SMTP (email sending). Fill in real SMTP credentials to enable
# verification/reset emails. Leave empty for demo mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@tradehub.app
EMAIL_FROM_NAME=TradeHub

# Stripe (payments). Fill in real keys to enable card payments.
# STRIPE_WEBHOOK_SECRET is required for webhooks to be accepted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_FEE_PERCENT=0

# Bank transfer details (shown to buyers when bank transfer is enabled)
BANK_TRANSFER_ENABLED=false
BANK_ACCOUNT_NAME=TradeHub Marketplace Ltd
BANK_NAME=Example National Bank
BANK_ACCOUNT_NUMBER=000123456789
BANK_ROUTING=021000021
BANK_SWIFT=EXNBUS33

# Crypto payments (shown to buyers when crypto is enabled)
CRYPTO_ENABLED=false
# Optional per-currency addresses, e.g. CRYPTO_ADDRESS_BTC=<btc address>

# Escrow (runs on an hourly cron)
AUTO_RELEASE_DAYS=7
ABANDON_PAYMENT_HOURS=24

# Serverless (Netlify) - set to true on Netlify
# NETLIFY=true
# DB_BLOB=true
