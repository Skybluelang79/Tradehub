# Frontend build-time variables (Vite). Copy this file to `.env` for local
# `npm run dev`; on Netlify/render/vercel set these as build-time environment
# variables. Vite only inlines variables prefixed with VITE_, and they end up
# in the shipped bundle — never put secrets here.
#
# These are distinct from server/.env.example, which holds the backend's
# runtime secrets.

# Where the browser sends API calls. Defaults to same-origin `/api`, which is
# what the Netlify Functions deployment uses. Set an absolute URL when the API
# is hosted elsewhere (Render/Railway/Fly):
# VITE_API_URL=https://tradehub-api.onrender.com/api

# The Socket.IO client is disabled on hosts that cannot hold WebSockets
# (serverless). Chat then runs over REST polling. netlify.toml sets this to
# "true" automatically; set it manually for other serverless targets.
# VITE_DISABLE_SOCKET=true

# Social sign-in. Each button is hidden until its matching client id is set.
# Google ID tokens are verified server-side against Google (no backend secret).
# Facebook also needs FACEBOOK_APP_ID + FACEBOOK_APP_SECRET in server/.env.
# VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# VITE_FACEBOOK_APP_ID=1234567890

# Firebase web config. Without it, Firebase-backed auth and push notifications
# are disabled, but the rest of the app keeps working.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=
